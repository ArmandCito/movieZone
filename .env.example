#Copy this file to .env and fill in the values

EXPO_PUBLIC_TMDB_API_KEY=
EXPO_PUBLIC_TMDB_TOKEN=
EXPO_PUBLIC_TMDB_API_URL=https://api.themoviedb.org/3/
EXPO_PUBLIC_TMDB_IMAGE_URL=https://image.tmdb.org/t/p/



EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs. These are public identifiers, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Meta public app configuration. Never put the Facebook App Secret here.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
